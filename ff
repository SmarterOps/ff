#!/usr/bin/env bash

set -euo pipefail

VERSION="1.1.0"

show_help() {
  cat <<'HELP'
ff - Fast File and Directory Creator

Usage:
  ff [options] <path> [path2 ...]
  ff --dir <path>
  ff --file <path>
  ff --color <path>
  ff --no-color <path>
  ff -h | --help
  ff -V | --version

Options:
  --dir PATH   Create PATH as a directory.
  --file PATH  Create PATH as a file.
  --color      Force colored output when supported.
  --no-color   Disable colored output.
  -h, --help   Show this help message.
  -V, --version Show the version number.

Examples:
  Create project directories:
    ff my-app/src my-app/tests

  Create files and their parent directories:
    ff my-app/src/main.js my-app/package.json my-app/README.md

  Create a directory with a dotted name:
    ff --dir my-app/config.v2

  Create a configuration file:
    ff --file my-app/.env
HELP
}

is_probably_file() {
  local path="$1"
  local name="${path##*/}"

  [[ -z "$name" || "$name" == "." || "$name" == ".." ]] && return 1

  if [[ "$name" == *.* ]]; then
    return 0
  fi

  return 1
}

create_path() {
  local target="$1"
  local forced_type="${2:-}"
  local is_file=false

  if [[ -z "$target" ]]; then
    echo "ff: path must not be empty." >&2
    return 2
  fi

  if [[ "$forced_type" == "file" ]]; then
    is_file=true
  elif [[ "$forced_type" == "dir" ]]; then
    is_file=false
  elif is_probably_file "$target"; then
    is_file=true
  fi

  if [[ "$is_file" == true ]]; then
    if [[ -d "$target" ]]; then
      echo "[ALREADY EXISTS] $target (directory)"
      return
    fi
    if [[ -e "$target" || -L "$target" ]]; then
      echo "[ALREADY EXISTS] $target"
      return
    fi

    local dir_path="${target%/*}"
    if [[ "$dir_path" != "$target" ]]; then
      mkdir -p -- "$dir_path"
    fi
    touch -- "$target"
    printf '[FILE CREATED] %s\n' "$(colorize_path "$target" file)"
    return
  fi

  if [[ -d "$target" ]]; then
    echo "[ALREADY EXISTS] $target (directory)"
    return
  fi

  mkdir -p -- "$target"
  printf '[FOLDER CREATED] %s\n' "$(colorize_path "$target" dir)"
}

supports_color() {
  [[ "${COLOR_ENABLED:-true}" == true ]] || return 1
  [[ -n "${NO_COLOR:-}" ]] && return 1
  [[ "${TERM:-}" != dumb ]] || return 1

  return 0
}

colorize() {
  local text="$1"
  local code="$2"

  if supports_color; then
    printf '\033[%sm%s\033[0m' "$code" "$text"
  else
    printf '%s' "$text"
  fi
}

colorize_path() {
  local path="$1"
  local type="$2"
  local parent=""
  local name=""

  if ! supports_color; then
    printf '%s' "$path"
    return
  fi

  if [[ "$type" == "file" ]]; then
    if [[ "$path" == */* ]]; then
      parent="${path%/*}/"
      name="${path##*/}"
      printf '%s%s' "$(colorize "$parent" "34")" "$(colorize "$name" "33")"
    else
      colorize "$path" "33"
    fi
  elif [[ "$path" == */* ]]; then
    colorize "$path" "34"
  else
    colorize "$path" "32"
  fi
}

is_option() {
  case "$1" in
    -h|--help|-V|--version|--dir|--file|--color|--no-color|--)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

COLOR_ENABLED=false
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
  COLOR_ENABLED=true
fi
for argument in "$@"; do
  case "$argument" in
    --color) COLOR_ENABLED=true ;;
    --no-color) COLOR_ENABLED=false ;;
  esac
done

paths_seen=0
while (($#)); do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -V|--version)
      echo "ff $VERSION"
      exit 0
      ;;
    --dir)
      if (($# < 2)) || is_option "$2"; then
        echo "ff: --dir requires a path." >&2
        exit 2
      fi
      create_path "$2" "dir"
      paths_seen=$((paths_seen + 1))
      shift 2
      ;;
    --file)
      if (($# < 2)) || is_option "$2"; then
        echo "ff: --file requires a path." >&2
        exit 2
      fi
      create_path "$2" "file"
      paths_seen=$((paths_seen + 1))
      shift 2
      ;;
    --no-color)
      COLOR_ENABLED=false
      shift
      ;;
    --color)
      COLOR_ENABLED=true
      shift
      ;;
    --)
      shift
      while (($#)); do
        create_path "$1"
        paths_seen=$((paths_seen + 1))
        shift
      done
      ;;
    *)
      create_path "$1"
      paths_seen=$((paths_seen + 1))
      shift
      ;;
  esac
done

if ((paths_seen == 0)); then
  echo "ff: provide at least one path." >&2
  show_help >&2
  exit 2
fi
